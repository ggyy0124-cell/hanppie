# Classroom runner as a system service; see cpp/classroom/README.md.
[Unit]
Description=Hanppie classroom runner
Wants=network-online.target
After=network-online.target

[Service]
# null admits sandboxed pages, like the sample page on a static site here.
ExecStart=/usr/bin/python3 /opt/hanppie-classroom/runner.py --header /opt/hanppie-classroom/hanppie.h --allow-origin null
Restart=on-failure
# Programs run as an unprivileged throwaway user with a read-only system,
# no access to home directories and a private /tmp for compiling.
DynamicUser=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
NoNewPrivileges=yes
# Shared by the service, the compiler (about 300 MB) and the program.
MemoryMax=768M
TasksMax=64

[Install]
WantedBy=multi-user.target
